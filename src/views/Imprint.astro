---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalNotice from '../components/LegalNotice.astro';
import Value from '../components/Value.astro';
import { legalPaths } from '../lib/content';
import { site } from '../site.config';
import type { Lang } from '../i18n';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const en = lang === 'en';
const tx = (english: string, german: string) => (en ? english : german);
const c = site.contact;
---

<BaseLayout
  lang={lang}
  title={tx('Imprint', 'Impressum')}
  description={tx('Imprint (legal notice) of 2eno.dev.', 'Impressum (Anbieterkennzeichnung) von 2eno.dev.')}
  alternates={legalPaths.imprint}
>
  <article class="container section prose">
    <h1>{tx('Imprint', 'Impressum')}</h1>

    <LegalNotice lang={lang} germanHref={en ? legalPaths.imprint.de : undefined} />

    <h2>{tx('Information pursuant to § 5 DDG (German Digital Services Act)', 'Angaben gemäß § 5 DDG')}</h2>
    <address>
      <Value value={c.name} /><br />
      <Value value={c.street} /><br />
      <Value value={c.city} /><br />
      {c.country[lang]}
    </address>

    <h2>{tx('Contact', 'Kontakt')}</h2>
    <p>
      {tx('Email', 'E-Mail')}: <Value value={c.email} /><br />
      {tx('Phone', 'Telefon')}: <Value value={c.phone} />
    </p>

    <h2>{tx('Responsible for content under § 18(2) MStV', 'Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV')}</h2>
    <address>
      <Value value={c.name} /><br />
      <Value value={c.street} /><br />
      <Value value={c.city} />
    </address>

    <p class="muted">
      <mark class="placeholder">
        {
          tx(
            '[If applicable, add: VAT ID under § 27a UStG, business ID, professional liability insurance etc. Omit anything that does not apply.]',
            '[Falls zutreffend ergänzen: Umsatzsteuer-ID nach § 27a UStG, Wirtschafts-ID, Angaben zur Berufshaftpflicht o. Ä. Nicht zutreffende Angaben weglassen.]',
          )
        }
      </mark>
    </p>

    <h2>{tx('Consumer dispute resolution', 'Verbraucherstreitbeilegung')}</h2>
    <p>
      {
        tx(
          'I am neither willing nor obliged to participate in dispute resolution proceedings before a consumer arbitration board.',
          'Ich bin nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.',
        )
      }
    </p>

    <h2>{tx('Liability for links', 'Haftung für Links')}</h2>
    <p>
      {
        tx(
          'This website contains links to external third-party websites whose content I have no control over. The respective provider or operator is always responsible for the content of linked pages. If I become aware of any legal violations, I will remove such links immediately.',
          'Diese Website enthält Links zu externen Websites Dritter, auf deren Inhalte ich keinen Einfluss habe. Für die Inhalte der verlinkten Seiten ist stets der jeweilige Anbieter oder Betreiber verantwortlich. Bei Bekanntwerden von Rechtsverletzungen werde ich derartige Links umgehend entfernen.',
        )
      }
    </p>
  </article>
</BaseLayout>

<style>
  address {
    font-style: normal;
  }
</style>
