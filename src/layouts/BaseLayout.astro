---
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';
import { htmlLang, t, type Lang } from '../i18n';

export interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Site-relative Pfade der Sprachversionen dieser Seite (für hreflang und Sprachumschalter) */
  alternates?: Partial<Record<Lang, string>>;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { lang, description = site.description[lang], alternates = {}, ...rest } = Astro.props;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f7fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090f" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <Seo lang={lang} description={description} alternates={alternates} {...rest} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">{t(lang, 'skip')}</a>
    <Header lang={lang} alternates={alternates} />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
