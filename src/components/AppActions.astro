---
/**
 * Download-/Store-Buttons einer App.
 *
 * Google Play: bewusst eigener Button statt offiziellem Badge-Bild (das darf nur
 * unverändert gemäß den Markenrichtlinien genutzt werden). Wer es möchte, lädt es
 * unter https://play.google.com/intl/de/badges/ herunter, legt es lokal ab
 * (nicht von Google-Servern einbinden!) und ersetzt den Play-Button.
 */
import Icon from './Icon.astro';
import type { App } from '../lib/content';
import { t, type Lang } from '../i18n';

export interface Props {
  app: App;
  lang: Lang;
}

const { app, lang } = Astro.props;
const { playStoreUrl, downloadUrl, repo, status, name } = app.data;
const onPlay = playStoreUrl && status !== 'coming-soon';
---

<div class="actions">
  {
    onPlay && (
      <a class="button play" href={playStoreUrl} rel="noopener">
        <Icon name="play" size={20} />
        <span>
          <small>{t(lang, 'app.play.on')}</small>
          Google Play<span class="visually-hidden">: {name} {t(lang, 'app.play.download')}</span>
        </span>
      </a>
    )
  }
  {
    downloadUrl && (
      <a class:list={['button', { secondary: onPlay }]} href={downloadUrl} rel="noopener">
        <Icon name="download" />
        {t(lang, 'app.apk')}
        <span class="visually-hidden"> ({name}, {t(lang, 'app.apk.sr')})</span>
      </a>
    )
  }
  {
    repo && (
      <a class="button secondary" href={repo} rel="noopener">
        <Icon name="github" />
        {t(lang, 'app.source')}
        <span class="visually-hidden"> – {name} {t(lang, 'app.source.sr')}</span>
      </a>
    )
  }
  {
    !onPlay && !downloadUrl && (
      <p class="soon">{t(lang, status === 'in-development' ? 'app.noDownload.dev' : 'app.noDownload.soon')}</p>
    )
  }
</div>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }
  .play {
    padding-block: 0.45rem;
    line-height: 1.1;
  }
  .play small {
    display: block;
    font-size: 0.66rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.8;
  }
  .soon {
    flex-basis: 100%;
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-subtle);
  }
</style>
