---
import { site } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <div class="about">
      <a href="/" class="brand">
        <img src="/favicon.svg" alt="" width="26" height="26" />
        2eno.dev
      </a>
      <p class="muted">
        Android-Apps und Open-Source-Werkzeuge. Statisch gebaut, ohne Cookies, Tracker und
        Fremd-Ressourcen.
      </p>
    </div>
    <nav aria-label="Seiten">
      <h2 class="col-title">Seiten</h2>
      <ul>
        <li><a href="/">Start</a></li>
        <li><a href="/apps/">Apps</a></li>
        <li><a href="/#projekte">Projekte</a></li>
      </ul>
    </nav>
    <nav aria-label="Rechtliches">
      <h2 class="col-title">Rechtliches</h2>
      <ul>
        <li><a href="/impressum/">Impressum</a></li>
        <li><a href="/datenschutz/">Datenschutz</a></li>
      </ul>
    </nav>
    <nav aria-label="Profile">
      <h2 class="col-title">Profile</h2>
      <ul>
        {
          site.links.map((l) => (
            <li>
              <a href={l.href} rel="me noopener">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="container bottom">
    <p>© {year} 2eno</p>
    <p>Gebaut mit Astro · Gehostet auf GitHub Pages</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 2rem;
    border-top: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-muted) 45%, var(--bg));
    font-size: 0.95rem;
  }
  .inner {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 2rem;
    padding-block: 3rem 2rem;
  }
  @media (max-width: 760px) {
    .inner {
      grid-template-columns: repeat(2, 1fr);
    }
    .about {
      grid-column: 1 / -1;
    }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text);
    text-decoration: none;
    font-size: 1.1rem;
  }
  .brand img {
    border-radius: 8px;
  }
  .about p {
    max-width: 22rem;
    margin: 0.75rem 0 0;
  }
  .col-title {
    font-size: 0.78rem;
    font-family: var(--font-mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-subtle);
    margin: 0 0 0.75rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  ul a {
    color: var(--text-muted);
    text-decoration: none;
  }
  ul a:hover {
    color: var(--text);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.25rem 2rem;
    border-top: 1px solid var(--border);
    color: var(--text-subtle);
    font-size: 0.85rem;
  }
  .bottom p {
    margin: 0;
  }
</style>
