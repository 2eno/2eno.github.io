---
import { site } from '../site.config';
import { localePath, t, type Lang } from '../i18n';
import { legalPaths } from '../lib/content';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <div class="about">
      <a href={localePath(lang, '/')} class="brand">
        <img src="/favicon.svg" alt="" width="26" height="26" />
        2eno.dev
      </a>
      <p class="muted">{t(lang, 'footer.about')}</p>
    </div>
    <nav aria-label={t(lang, 'footer.pages')}>
      <h2 class="col-title">{t(lang, 'footer.pages')}</h2>
      <ul>
        <li><a href={localePath(lang, '/')}>{t(lang, 'nav.home')}</a></li>
        <li><a href={localePath(lang, '/apps/')}>{t(lang, 'nav.apps')}</a></li>
        <li><a href={`${localePath(lang, '/')}#projects`}>{t(lang, 'nav.projects')}</a></li>
      </ul>
    </nav>
    <nav aria-label={t(lang, 'footer.legal')}>
      <h2 class="col-title">{t(lang, 'footer.legal')}</h2>
      <ul>
        <li><a href={legalPaths.imprint[lang]}>{t(lang, 'legal.imprint')}</a></li>
        <li><a href={legalPaths.privacy[lang]}>{t(lang, 'legal.privacy')}</a></li>
      </ul>
    </nav>
    <nav aria-label={t(lang, 'footer.profiles')}>
      <h2 class="col-title">{t(lang, 'footer.profiles')}</h2>
      <ul>
        {
          site.links.map((link) => (
            <li>
              <a href={link.href} rel="me noopener">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="container bottom">
    <p>© {year} 2eno</p>
    <p>{t(lang, 'footer.built')}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 2rem;
    border-top: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-muted) 45%, var(--bg));
    font-size: 0.95rem;
  }
  .inner {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 2rem;
    padding-block: 3rem 2rem;
  }
  @media (max-width: 760px) {
    .inner {
      grid-template-columns: repeat(2, 1fr);
    }
    .about {
      grid-column: 1 / -1;
    }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text);
    text-decoration: none;
    font-size: 1.1rem;
  }
  .brand img {
    border-radius: 8px;
  }
  .about p {
    max-width: 22rem;
    margin: 0.75rem 0 0;
  }
  .col-title {
    font-size: 0.78rem;
    font-family: var(--font-mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-subtle);
    margin: 0 0 0.75rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  ul a {
    color: var(--text-muted);
    text-decoration: none;
  }
  ul a:hover {
    color: var(--text);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.25rem 2rem;
    border-top: 1px solid var(--border);
    color: var(--text-subtle);
    font-size: 0.85rem;
  }
  .bottom p {
    margin: 0;
  }
</style>
