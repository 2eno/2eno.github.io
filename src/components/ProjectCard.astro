---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { languageColor, type Project } from '../lib/content';

export interface Props {
  project: Project;
  large?: boolean;
}

const { project, large = false } = Astro.props;
const { name, description, url, tags, language, license, category, image, imageAlt } = project.data;
const external = /^https?:\/\//.test(url);
---

<article class:list={['card', 'project-card', { large, 'has-image': image }]}>
  {
    image && (
      <div class="media">
        <Image src={image} alt={imageAlt ?? ''} widths={[400, 800]} sizes="(max-width: 700px) 100vw, 400px" />
      </div>
    )
  }
  <div class="body">
    <p class="category">{category}</p>
    <h3>
      <a class="card-link" href={url} rel={external ? 'noopener' : undefined}>
        {name}
        {external && <span class="visually-hidden"> (auf GitHub)</span>}
      </a>
      {external && <Icon name="arrow-up-right" size={18} class="ext" />}
    </h3>
    <p class="muted">{description}</p>
    {
      tags.length > 0 && (
        <ul class="tag-list" aria-label="Schlagworte">
          {tags.slice(0, large ? 5 : 3).map((t) => (
            <li class="tag">{t}</li>
          ))}
        </ul>
      )
    }
    <div class="foot">
      {language && <span class="lang" style={`--lang-color: ${languageColor[language] ?? 'gray'}`}>{language}</span>}
      {license && <span class="license">{license}</span>}
    </div>
  </div>
</article>

<style>
  .project-card {
    padding: 0;
    overflow: hidden;
    gap: 0;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    flex: 1;
  }
  .category {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h3 {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 1.2rem;
  }
  h3 :global(.ext) {
    color: var(--text-subtle);
    transition: transform 0.25s var(--ease);
  }
  .project-card:hover h3 :global(.ext) {
    transform: translate(2px, -2px);
    color: var(--text);
  }
  .foot {
    display: flex;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.25rem;
    font-size: 0.85rem;
    color: var(--text-subtle);
  }
  .media {
    background: #f4f4f4;
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    transition: transform 0.5s var(--ease);
  }
  .project-card:hover .media img {
    transform: scale(1.04);
  }
  .large.has-image {
    flex-direction: row;
  }
  .large .media {
    flex: 0 0 38%;
    aspect-ratio: auto;
    max-height: 19rem;
  }
  .large .body {
    justify-content: center;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }
  .large .foot {
    margin-top: 0;
  }
  .large h3 {
    font-size: 1.5rem;
  }
  @media (max-width: 700px) {
    .large.has-image {
      flex-direction: column;
    }
    .large .media {
      min-height: 0;
      aspect-ratio: 16 / 10;
    }
  }
</style>
