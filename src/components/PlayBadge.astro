---
/**
 * Link zum Google-Play-Eintrag.
 *
 * Bewusst als eigener Button statt offiziellem Badge-Bild: Das offizielle Badge
 * darf nur unverändert und gemäß den Google-Play-Markenrichtlinien verwendet
 * werden. Wer es nutzen möchte, lädt es unter
 * https://play.google.com/intl/de/badges/ herunter, legt es lokal ab
 * (keine Einbindung von Google-Servern!) und ersetzt den Inhalt dieses Links.
 */
import type { App } from '../lib/content';

export interface Props {
  app: App;
}

const { app } = Astro.props;
const { playStoreUrl, status, name } = app.data;
const available = playStoreUrl && status !== 'coming-soon';
---

{
  available ? (
    <a class="button play" href={playStoreUrl} rel="noopener">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
        <path fill="currentColor" d="M4 2.5v19a1 1 0 0 0 1.5.87l16-9.5a1 1 0 0 0 0-1.74l-16-9.5A1 1 0 0 0 4 2.5Z" />
      </svg>
      <span>
        <small>Jetzt bei</small>
        Google Play
        <span class="visually-hidden">: {name} herunterladen</span>
      </span>
    </a>
  ) : (
    <p class="button secondary soon" role="note">
      Demnächst bei Google Play
    </p>
  )
}

<style>
  .play {
    padding: 0.6rem 1.25rem 0.6rem 1rem;
    line-height: 1.15;
    background: #111;
    color: #fff;
    border-color: #444;
  }
  @media (prefers-color-scheme: dark) {
    .play {
      background: #000;
      border-color: #555;
    }
  }
  .play small {
    display: block;
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .play > span {
    font-size: 1.15rem;
  }
  .soon {
    margin: 0;
    cursor: default;
  }
</style>
