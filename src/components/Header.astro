---
import { site } from '../site.config';
import Icon from './Icon.astro';
import { languages, langName, localePath, switchHref, t, type Lang } from '../i18n';

export interface Props {
  lang: Lang;
  alternates?: Partial<Record<Lang, string>>;
}

const { lang, alternates = {} } = Astro.props;
const nav = [
  { href: localePath(lang, '/apps/'), label: t(lang, 'nav.apps') },
  { href: `${localePath(lang, '/')}#projects`, label: t(lang, 'nav.projects') },
];
const path = Astro.url.pathname;
const github = site.links.find((l) => l.label === 'GitHub');
const other = languages.filter((l) => l !== lang);
---

<header class="site-header">
  <div class="container inner">
    <a href={localePath(lang, '/')} class="brand" aria-label={`${site.name} – ${t(lang, 'brand.home')}`}>
      <img src="/favicon.svg" alt="" width="30" height="30" />
      <span>2eno<span class="tld">.dev</span></span>
    </a>
    <nav aria-label={t(lang, 'nav.main')}>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        {
          other.map((target) => {
            const href = switchHref(target, alternates[target] ?? localePath(target, '/'));
            return (
              <li>
                <a class="lang-switch" href={href} hreflang={target} lang={target} aria-label={langName[target]}>
                  {target.toUpperCase()}
                </a>
              </li>
            );
          })
        }
        {
          github && (
            <li>
              <a class="icon-link" href={github.href} rel="me noopener" aria-label={t(lang, 'nav.github')}>
                <Icon name="github" size={20} />
              </a>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text);
    text-decoration: none;
    font-size: 1.15rem;
  }
  .brand img {
    border-radius: 9px;
    box-shadow: var(--shadow);
  }
  .tld {
    color: var(--text-subtle);
    font-weight: 600;
  }
  ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition:
      color 0.15s,
      background 0.15s;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
    background: var(--bg-muted);
  }
  .lang-switch {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    border: 1px solid var(--border);
    padding: 0.3rem 0.6rem;
  }
  .icon-link {
    padding: 0.5rem;
  }
  @media (max-width: 480px) {
    .inner {
      gap: 0.5rem;
    }
    .tld {
      display: none;
    }
    ul {
      gap: 0.1rem;
    }
    nav a {
      padding-inline: 0.5rem;
      font-size: 0.9rem;
    }
    .icon-link {
      padding: 0.4rem;
    }
  }
</style>
