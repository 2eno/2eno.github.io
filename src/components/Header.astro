---
import { site } from '../site.config';
import Icon from './Icon.astro';

const nav = [
  { href: '/apps/', label: 'Apps' },
  { href: '/#projekte', label: 'Projekte' },
];
const path = Astro.url.pathname;
const github = site.links.find((l) => l.label === 'GitHub');
---

<header class="site-header">
  <div class="container inner">
    <a href="/" class="brand" aria-label={`${site.name} – zur Startseite`}>
      <img src="/favicon.svg" alt="" width="30" height="30" />
      <span>2eno<span class="tld">.dev</span></span>
    </a>
    <nav aria-label="Hauptnavigation">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        {
          github && (
            <li>
              <a class="icon-link" href={github.href} rel="me noopener" aria-label="GitHub-Profil">
                <Icon name="github" size={20} />
              </a>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text);
    text-decoration: none;
    font-size: 1.15rem;
  }
  .brand img {
    border-radius: 9px;
    box-shadow: var(--shadow);
  }
  .tld {
    color: var(--text-subtle);
    font-weight: 600;
  }
  ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition:
      color 0.15s,
      background 0.15s;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
    background: var(--bg-muted);
  }
  .icon-link {
    padding: 0.5rem;
  }
</style>
